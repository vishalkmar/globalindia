# Global India website — environment variables (names only, never commit values)
# Copy to .env.local for development:  npm run secrets  (generates random secrets for you)
# Only NEXT_PUBLIC_* values ever reach the browser. Never put a secret in a NEXT_PUBLIC_ variable.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=            # pooled connection string (…-pooler…/neondb?sslmode=require)
DIRECT_URL=              # direct (non-pooled) connection string, used by prisma migrate
SHADOW_DATABASE_URL=       # empty database for prisma migrate dev only (local PGlite :5434 or a Neon "shadow" branch)

# --- Auth secrets (each >= 64 random bytes, different per environment) ---
JWT_ACCESS_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
REFRESH_PEPPER=
OTP_PEPPER=
TOTP_ENC_KEY=            # 32 bytes, base64 — AES-256-GCM key for authenticator secrets
MFA_PENDING_SECRET=
IP_HASH_SALT=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_WEBHOOK_SECRET=

# --- Brevo (transactional email) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_WEBHOOK_SECRET=
BREVO_LIST_ID=

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudflare Turnstile ---
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=

# --- Seed (development / first deploy only; remove after launch) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
ALLOW_PROD_SEED=

# Daily trash purge (Vercel Cron sends it as a Bearer token), 32+ random characters
CRON_SECRET=
